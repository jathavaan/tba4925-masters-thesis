% =============================================================================
% Bibliography (BibLaTeX)
% =============================================================================
\usepackage[
	backend=biber,
	style=apa,
	date=long,        % long: 24th Mar. 1997 | short: 24/03/1997
	sorting=nyt,
	maxcitenames=3    % Maximum number of names before et al.
]{biblatex}
\addbibresource{bibliography.bib}

% =============================================================================
% Utilities
% =============================================================================
\usepackage{comment}   % Comment out blocks
\usepackage{afterpage} % Defer commands until after current page

% =============================================================================
% Custom Commands
% =============================================================================
\newcommand\myemptypage{%
	\null
	\thispagestyle{empty}
	\addtocounter{page}{-1}
	\newpage
} % Insert an empty page without page number or page counter increment
