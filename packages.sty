% commented-out \includegraphics line giving the planned file path; swap the box
% for that line when the artwork exists, then delete this macro.
%   \scaffoldbox{<width as fraction of \textwidth>}{<one-line description>}
% -----------------------------------------------------------------------------
\newcommand{\scaffoldbox}[2]{{%
	\setlength{\fboxsep}{6pt}%
	\fbox{\begin{minipage}[t][0.20\textheight][c]{#1\textwidth}%
		\centering\itshape\small\color{thesisgray}%
		[\,placeholder -- not yet produced\,]\\[4pt]#2%
	\end{minipage}}%
}}

% =============================================================================
% Breakable inline code  (\texttt becomes line-breakable)
% =============================================================================
% Long monospace literals (Spark/Sedona/Azure config keys, dotted Python paths,
% BENCHMARK_* constants) cannot hyphenate and so overflow the right margin in
% body text, footnotes and captions. \texttt is redefined so a line may break
% after the separators  . , : ; = / + -  and after \_ , by inserting a
% *zero-width* \allowbreak. No glyph is added, removed or hyphenated: the
% rendered characters are byte-for-byte identical; only the set of legal break
% points grows. (Two literals already carry a manual \allowbreak; the duplicate
% is harmless.)
%
% The argument is walked token-by-token with \futurelet, so spaces, brace groups
% and control sequences (\_, \url{...}, \textbackslash, \allowbreak) pass through
% unchanged; only genuine separator tokens gain a break. \texttt stays robust
% (\DeclareRobustCommand), so it is safe inside \caption{} and re-typesets
% correctly in the List of Figures / Tables -- the helper macros never reach the
% .aux/.lof because only \protect\texttt{<literal>} is written there.
%
% To revert to stock \texttt, comment this whole block and uncomment the line:
%   \makeatletter \let\texttt\bk@origtexttt \makeatother
% -----------------------------------------------------------------------------
\makeatletter
\let\bk@origtexttt\texttt           % stock \texttt (the ttfamily text-font cmd)
\let\bk@uscore\_                    % the text \_ token, for identity comparison
\def\bk@stopmarker{\bk@stopmarker}  % unique end sentinel (only peeked/consumed)

\def\bk@loop{\futurelet\bk@tok\bk@dispatch}
\def\bk@dispatch{%
	\ifx\bk@tok\bk@stopmarker
		\let\bk@next\bk@end
	\else\ifx\bk@tok\@sptoken
		\let\bk@next\bk@dospace
	\else\ifx\bk@tok\bgroup
		\let\bk@next\bk@grabgroup
	\else
		\let\bk@next\bk@grab
	\fi\fi\fi
	\bk@next}
\def\bk@end\bk@stopmarker{}                  % swallow the sentinel and stop
\def\bk@grabgroup#1{{#1}\bk@loop}            % keep a brace group intact (no descent)
\def\bk@grab#1{#1\bk@checkbreak{#1}\bk@loop} % emit token, maybe add break, recurse
\expandafter\def\expandafter\bk@dospace\space{ \bk@loop} % keep the space, recurse

% Append a zero-width \allowbreak after a separator token (never a hyphen).
\def\bk@checkbreak#1{%
	\ifx#1\bk@uscore\allowbreak\else
	\ifx#1.\allowbreak\else
	\ifx#1,\allowbreak\else
	\ifx#1:\allowbreak\else
	\ifx#1;\allowbreak\else
	\ifx#1=\allowbreak\else
	\ifx#1/\allowbreak\else
	\ifx#1+\allowbreak\else
	\ifx#1-\allowbreak\else
	\fi\fi\fi\fi\fi\fi\fi\fi\fi}

\DeclareRobustCommand{\texttt}[1]{\bk@origtexttt{\bk@loop#1\bk@stopmarker}}
\makeatother

