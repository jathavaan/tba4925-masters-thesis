% \inputtablebody{<file>} -- include a generated table-body fragment (the
% "& ... \\" rows that slot between \midrule and \bottomrule). Uses the TeX
% primitive \@@input rather than LaTeX's \input: a plain \input of a fragment
% whose last row ends in \\ collides with the following \bottomrule across the
% file boundary inside a tabular (-> "Misplaced \noalign"). The primitive reads
% the rows without that wrapper, so the float, tabular and \bottomrule are
% unchanged. (longtable bodies are immune and may keep plain \input.)
\newcommand{\inputtablebody}[1]{\@@input #1 }

