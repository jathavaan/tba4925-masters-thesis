\usepackage[acronym,nonumberlist,nopostdot]{glossaries}
% Two-column abbreviations list: abbreviation + expansion. The super4col style
% referenced an undefined \glssymbolwidth and added empty symbol/page columns
% that acronyms (with nonumberlist) never fill. Inherit the stock "long" style's
% row layout (a known-good longtable) and override only the table preamble, where
% @{} drops the leading tabcolsep so entries align with the margin. Wrapped in
% \newglossarystyle so the print pass re-applies this layout, not the stock one.
\newglossarystyle{abbreviations}{%
	\setglossarystyle{long}%
	\renewenvironment{theglossary}%
		{\setlength{\LTleft}{0pt}%
		 \setlength{\LTright}{\fill}%
		 \begin{longtable}{@{}lp{\glsdescwidth}}}%
		{\end{longtable}}%
}
\setglossarystyle{abbreviations}
\renewcommand{\glsnamefont}[1]{\textbf{#1}}    % bold abbreviation
\makeglossaries
\loadglsentries{Chapters/00-preliminary/sub-chapters/03-abbreviations}
% Lowercased acronym expansions for mid-sentence use; the abbreviations list
% stores Title Case, so common-noun expansions are lowered at the point of use.
\newcommand*{\acrlonglc}[1]{\MakeLowercase{\glsentrylong{#1}}}
\newcommand*{\acrfulllc}[1]{\acrlonglc{#1}~(\acrshort{#1})}

